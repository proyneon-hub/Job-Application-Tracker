# Copy this file to .env.local and fill in values from your Supabase project:
# Supabase dashboard -> Project Settings -> API Keys / Data API.
# Both values are safe to expose to the browser: access is enforced by
# row-level security in the database. Never add the service-role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
